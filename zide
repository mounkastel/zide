    cpp | c++ | cxx) echo cpp ;;
    rust | rs) echo rust ;;
    c-cpp-mixed | mixed | c-cpp | c+cpp) echo mixed ;;
    *) return 1 ;;
  esac
}
norm_test() {
  case ${1,,} in
