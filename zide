init_configure() {
  if [[ $LANG_SEL == rust ]] || ((NO_CONFIGURE)); then return 0; fi
  if ! have cmake; then
    warn "cmake not found; skipped configure. $(install_hint cmake)"
    return 0
  fi
  if ((DRY_RUN)); then
    dry "cmake --preset dev (generate compile_commands.json)"
    return 0
  fi
  if try_run "cmake --preset dev (exporting compile commands for clangd)" \
    bash -c 'cd -- "$1" && cmake --preset dev' _ "$ROOT"; then
    if [[ -f $ROOT/build/dev/compile_commands.json ]]; then link_compdb build/dev/compile_commands.json; fi
  fi
  return 0
}

init_git() {
  local -a idc=()
  ((GIT)) || return 0
  if ! have git; then
    warn "git not found; skipped repository setup. $(install_hint git)"
    return 0
  fi
  if ((DRY_RUN)); then
    dry "git init + initial commit"
    return 0
  fi
  if git -C "$ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    info "already inside a git work tree; not creating a repository or commit"
    return 0
  fi
  if ! git -C "$ROOT" init -q -b main 2>/dev/null && ! git -C "$ROOT" init -q; then
    warn "could not initialise a git repository in $ROOT; continuing without version control (run 'git init' there manually)"
    return 0
  fi
  if ! git -C "$ROOT" add -A; then
    warn "git add failed in $ROOT; continuing without an initial commit (run 'git add -A && git commit' there manually)"
    return 0
  fi
  git -C "$ROOT" config --get user.name >/dev/null 2>&1 || idc+=(-c user.name=zide)
  git -C "$ROOT" config --get user.email >/dev/null 2>&1 || idc+=(-c user.email=zide@localhost)
  if git -C "$ROOT" "${idc[@]}" commit -q -m "chore: initial scaffold (zide $ZIDE_VERSION)"; then
    ok "git repository initialised with an initial commit"
  else
    warn "initial commit failed; run 'git commit' manually"
  fi
}

init_bare_remote() {
  [[ -n $BARE_REMOTE ]] || return 0
  local remote
  BARE_REMOTE=$(expand_tilde "$BARE_REMOTE") || exit "$?"
  remote=$(safe_path "$BARE_REMOTE") || exit "$?"
  if [[ -e $remote ]]; then
    [[ -d $remote ]] || die "$E_REFUSED" "bare remote path is not a directory: $remote (pass an empty directory to --bare-remote)"
    if [[ -n $(find "$remote" -mindepth 1 -maxdepth 1 -print -quit) ]] && ((!FORCE)); then
      die "$E_REFUSED" "bare remote path is not empty (use --force): $remote"
    fi
  fi
  if ((DRY_RUN)); then
    dry "git init --bare $remote + post-receive hook"
    return 0
  fi
  if ! git init -q --bare "$remote"; then
    warn "could not create a bare repository at $remote ($(install_hint git)); continuing without a remote"
    return 0
  fi
  mk_tmp
  cat >"$TMP_LAST" <<'EOF'
#!/usr/bin/env bash
# Stub post-receive hook installed by zide. Add CI triggers or notifications here.
set -Eeuo pipefail
while read -r oldrev newrev refname; do
  printf 'received %s: %s -> %s\n' "$refname" "$oldrev" "$newrev" >&2
done
EOF
  install -m 755 -- "$TMP_LAST" "$remote/hooks/post-receive"
  if [[ -d $ROOT/.git ]] && ! git -C "$ROOT" remote get-url origin >/dev/null 2>&1; then
    git -C "$ROOT" remote add origin "$remote"
  fi
  ok "bare remote ready: $remote"
}

cmd_init() {
  [[ -n ${POS_PATH:-} ]] || die "$E_USAGE" "init: missing <project-path>. Usage: zide init <project-path> --lang <c | cpp | rust> -y"
  POS_PATH=$(expand_tilde "$POS_PATH") || exit "$?"
  ROOT=$(safe_path "$POS_PATH") || exit "$?"
  if [[ -e $ROOT && ! -d $ROOT ]]; then die "$E_REFUSED" "target exists and is not a directory: $ROOT (pick another path)"; fi
  init_resolve
  init_tokens
  if [[ -n $BUILD_SEL ]]; then
    case $LANG_SEL in
      rust)
        [[ $BUILD_SEL == cargo ]] || die "$E_USAGE" "init: --build $BUILD_SEL clashes with --lang rust (Rust always uses cargo); drop --build"
        ;;
      *)
        [[ $BUILD_SEL == cmake ]] || die "$E_USAGE" "init: --build $BUILD_SEL clashes with --lang $LANG_SEL (C/C++ always uses CMake); drop --build"
        ;;
    esac
  fi
  if [[ -d $ROOT && -n $(find "$ROOT" -mindepth 1 -maxdepth 1 -print -quit) ]]; then
    info "target is not empty: existing files are preserved (differing ones are kept unless --force)"
  fi
  info "scaffolding '$INIT_NAME' ($LANG_SEL) in $ROOT"
  if [[ $LANG_SEL == rust ]]; then
    need_tool cargo 1
    need_tool rust-analyzer 1
  else
    need_tool cmake 1 "build"
    need_tool ninja 0 "default generator; falls back to Unix Makefiles"
    need_tool clangd 1 "language server"
    need_tool clang-format 0
    need_tool jq 0 "JSON validation"
    if [[ $LANG_SEL == c && $TESTFW =~ ^(catch2|doctest|gtest)$ ]]; then
      warn "C projects use the built-in CTest smoke test; '$TESTFW' ignored"
    fi
  fi
  mk_dir "$ROOT"
  if [[ $LANG_SEL == rust ]]; then init_rust; else init_cmake; fi
  init_license
  if [[ $LANG_SEL != rust ]]; then init_configure; fi
  init_git
  init_bare_remote
  ok "scaffold finished"
  print_report "Scaffold report"
  if [[ $LANG_SEL == rust ]]; then
    printf '\nNext steps:\n  cd %q && cargo test && cargo run && zed .\n' "$ROOT" >&2
  else
    printf '\nNext steps:\n  cd %q\n  cmake --preset dev && cmake --build --preset dev && ctest --preset dev\n  zed .\n' "$ROOT" >&2
  fi
}

