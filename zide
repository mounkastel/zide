#!/usr/bin/env bash
#
# zide - set up a Zed environment for native systems projects.
#
#   zide adopt <project-path>   retrofit an existing project (non-destructive)
#   zide init  <project-path>   scaffold a new, building, testable project
#   zide doctor                 report toolchain status with install hints
#
# Bash 5+, Linux. No network access at runtime. MIT licensed.
#
# Design rules
#   * Nothing is overwritten without --force; replaced files get .bak.<UTC ts>.
#   * Zed JSON files that already exist are MERGED (your keys win), never clobbered.
#   * Every generated JSON file is validated with jq (when installed) before write.
#   * Output is deterministic: same inputs => byte-identical files.
#
# Single-quoted literals below are generated file content (Zed JSON values, bash -c payloads, CMake variables), never shell expansions.
# shellcheck disable=SC2016
# tr ranges are ASCII-only on purpose: derived identifiers are ASCII by construction.
# shellcheck disable=SC2018,SC2019
set -Eeuo pipefail
shopt -u patsub_replacement 2>/dev/null || true

if ((BASH_VERSINFO[0] < 5)); then
  printf 'zide: Bash 5+ is required (found %s)\n' "$BASH_VERSION" >&2
  exit 2
fi

readonly ZIDE_VERSION="1.3.0"
readonly PROG="zide"
readonly E_USAGE=2 E_JSON=3 E_REFUSED=4

DRY_RUN=0
VERBOSE=0
FORCE=0
YES=0
COLOR=auto
JSON_OUT=0

# --------------------------------------------------------------------------
# Logging
# --------------------------------------------------------------------------
C_RESET="" C_DIM="" C_RED="" C_GREEN="" C_YELLOW="" C_BLUE="" C_CYAN="" C_BOLD=""

setup_colors() {
  C_RESET="" C_DIM="" C_RED="" C_GREEN="" C_YELLOW="" C_BLUE="" C_CYAN="" C_BOLD=""
  if [[ $COLOR != never && -z ${NO_COLOR:-} && -t 2 ]]; then
    C_RESET=$'\033[0m' C_DIM=$'\033[2m' C_RED=$'\033[31m' C_GREEN=$'\033[32m'
    C_YELLOW=$'\033[33m' C_BLUE=$'\033[34m' C_CYAN=$'\033[36m' C_BOLD=$'\033[1m'
  fi
}

WARNINGS=()
info() { printf '%s[info]%s %s\n' "$C_BLUE" "$C_RESET" "$*" >&2; }
ok() { printf '%s[ ok ]%s %s\n' "$C_GREEN" "$C_RESET" "$*" >&2; }
warn() {
  WARNINGS+=("$*")
  printf '%s[warn]%s %s\n' "$C_YELLOW" "$C_RESET" "$*" >&2
}
err() { printf '%s[fail]%s %s\n' "$C_RED" "$C_RESET" "$*" >&2; }
dbg() {
  if ((VERBOSE)); then printf '%s[dbug]%s %s\n' "$C_DIM" "$C_RESET" "$*" >&2; fi
}
dry() { printf '%s[dry ]%s %s\n' "$C_CYAN" "$C_RESET" "$*" >&2; }
die() {
  local rc=$1
  shift
  err "$*"
  exit "$rc"
}

TMPFILES=()
TMP_LAST=""
mk_tmp() {
  TMP_LAST=$(mktemp "${TMPDIR:-/tmp}/zide.XXXXXX")
  TMPFILES+=("$TMP_LAST")
}

cleanup() {
  local f
  if ((${INTERACTIVE:-0})); then printf '\033[?25h' >&2; fi
  for f in "${TMPFILES[@]}"; do rm -rf -- "$f"; done
}
on_err() {
  local rc=$?
  # die() already reported deliberate failures (also when raised inside $(...)).
  case $rc in "$E_USAGE" | "$E_JSON" | "$E_REFUSED" | 130) return 0 ;; esac
  if ((VERBOSE)); then
    err "internal error (exit $rc) at line ${BASH_LINENO[0]}: ${BASH_COMMAND}"
  else
    err "command failed (exit $rc): ${BASH_COMMAND} (re-run with --verbose for the location)"
  fi
}
trap on_err ERR
trap cleanup EXIT
trap 'err "interrupted"; exit 130' INT TERM

have() { command -v "$1" >/dev/null 2>&1; }

# --------------------------------------------------------------------------
# Toolchain probing and per-distro install hints
# --------------------------------------------------------------------------
pkg_family() {
  local id="" like=""
  if [[ -r /etc/os-release ]]; then
    # shellcheck disable=SC1091
    id=$(. /etc/os-release && printf '%s' "${ID:-}")
    # shellcheck disable=SC1091
    like=$(. /etc/os-release && printf '%s' "${ID_LIKE:-}")
  fi
  case " $id $like " in
    *" debian "* | *" ubuntu "*) echo apt; return 0 ;;
    *" fedora "* | *" rhel "* | *" centos "*) echo dnf; return 0 ;;
    *" arch "*) echo pacman; return 0 ;;
    *" suse "* | *opensuse* | *" sles "*) echo zypper; return 0 ;;
  esac
  local m
  for m in apt-get:apt dnf:dnf pacman:pacman zypper:zypper; do
    if have "${m%%:*}"; then echo "${m##*:}"; return 0; fi
  done
  echo unknown
}

install_hint() {
  local tool=$1 fam pkg
  fam=$(pkg_family)
  case $tool in
    cargo | rustc | rust-analyzer)
      if [[ $tool == rust-analyzer ]]; then
        echo "rustup component add rust-analyzer   (or your distro's rust-analyzer package)"
      else
        echo "install Rust via rustup (https://rustup.rs) or your distro's rust/cargo package"
      fi
      return 0
      ;;
    compdb | compiledb)
      echo "pipx install $tool"
      return 0
      ;;
  esac
  case $fam:$tool in
    apt:ninja | dnf:ninja) pkg=ninja-build ;;
    pacman:ninja | zypper:ninja) pkg=ninja ;;
    dnf:clangd | dnf:clang-format | dnf:clang-tidy) pkg=clang-tools-extra ;;
    pacman:clangd | pacman:clang-format | pacman:clang-tidy) pkg=clang ;;
    zypper:clangd | zypper:clang-format | zypper:clang-tidy) pkg=clang-tools ;;
    *) pkg=$tool ;;
  esac
  case $fam in
    apt) echo "sudo apt install $pkg" ;;
    dnf) echo "sudo dnf install $pkg" ;;
    pacman) echo "sudo pacman -S $pkg" ;;
    zypper) echo "sudo zypper install $pkg" ;;
    *) echo "install '$pkg' with your package manager" ;;
  esac
}

tool_version() {
  local out rc=0
  if ! have "$1"; then
    printf 'missing'
    return 0
  fi
  out=$("$1" --version 2>&1) || rc=$?
  out=$(printf '%s\n' "$out" | sed -n '1p')
  if ((rc)); then
    printf 'broken (%s)' "${out:-exit $rc}"
  else
    printf '%s' "${out:-unknown}"
  fi
}

# need_tool <tool> <required:0|1> <why>
need_tool() {
  local tool=$1 required=$2 why=${3:-}
  if have "$tool"; then
    dbg "$tool: $(tool_version "$tool")"
    return 0
  fi
  if ((required)); then
    warn "missing tool '$tool'${why:+ ($why)} -> $(install_hint "$tool")"
  else
    info "optional tool '$tool' not found${why:+ ($why)} -> $(install_hint "$tool")"
  fi
  return 0
}

print_toolchain() {
  local t
  for t in cmake ninja clangd clang-format clang-tidy git jq bear compiledb compdb meson gdb lldb cargo rustc rust-analyzer; do
    printf '  %-14s %s\n' "$t" "$(tool_version "$t")"
  done
}

# Doctor groups: "required" gates the exit code; "recommended" degrades gracefully; "optional" is situational.
DOCTOR_REQUIRED=(cmake clangd git cargo rustc)
DOCTOR_RECOMMENDED=(ninja jq clang-format clang-tidy rust-analyzer gdb)
DOCTOR_OPTIONAL=(bear compiledb compdb meson lldb)
DOC_MISS_ALL=() DOC_MISS_REQ=() DOC_COLOR=0
DOC_PROJECT=""
DOC_REQ=() DOC_REC=() DOC_OPT=()

# doctor_tiers: build DOC_REQ/DOC_REC/DOC_OPT; with a project path, tools for unused tracks are recommended (git stays required).
doctor_tiers() {
  local t
  DOC_REQ=("${DOCTOR_REQUIRED[@]}")
  DOC_REC=("${DOCTOR_RECOMMENDED[@]}")
  DOC_OPT=("${DOCTOR_OPTIONAL[@]}")
  if [[ -z $DOC_PROJECT ]]; then return 0; fi
  DOC_REQ=()
  DOC_REC=()
  for t in "${DOCTOR_REQUIRED[@]}"; do
    case $t in
      cmake | clangd) if ((DETECT_C || DETECT_CPP)); then DOC_REQ+=("$t"); else DOC_REC+=("$t"); fi ;;
      cargo | rustc) if ((DETECT_RUST)); then DOC_REQ+=("$t"); else DOC_REC+=("$t"); fi ;;
      *) DOC_REQ+=("$t") ;;
    esac
  done
  DOC_REC+=("${DOCTOR_RECOMMENDED[@]}")
}

tool_tier() {
  local t=$1 x
  for x in "${DOC_REQ[@]}"; do if [[ $x == "$t" ]]; then printf 'required'; return 0; fi; done
  for x in "${DOC_REC[@]}"; do if [[ $x == "$t" ]]; then printf 'recommended'; return 0; fi; done
  printf 'optional'
}

doc_line() { # <ok|miss> <tool> <detail> <tier>
  if ((DOC_COLOR)); then
    local color=$C_GREEN
    if [[ $1 == miss ]]; then
      if [[ $4 == required ]]; then color=$C_RED; else color=$C_YELLOW; fi
    fi
    printf '  %s%-4s%s %-12s %s\n' "$color" "$1" "$C_RESET" "$2" "$3"
  else
    printf '  %-4s %-12s %s\n' "$1" "$2" "$3"
  fi
}

doctor_row() { # <tool> <tier>
  local tool=$1 tier=$2 ver
  ver=$(tool_version "$tool")
  case $ver in
    missing | broken*)
      DOC_MISS_ALL+=("$tool")
      if [[ $tier == required ]]; then DOC_MISS_REQ+=("$tool"); fi
      doc_line miss "$tool" "$ver -> $(install_hint "$tool")" "$tier"
      ;;
    *)
      doc_line ok "$tool" "$ver" "$tier"
      ;;
  esac
}

doctor_summary() {
  local n=${#DOC_MISS_ALL[@]} m=${#DOC_MISS_REQ[@]} what="things"
  if ((n == 0)); then
    printf 'summary: ready\n'
    return 0
  fi
  if ((n == 1)); then what="thing"; fi
  printf 'summary: %d %s to fix (%d required): %s\n' "$n" "$what" "$m" "$(join_by ', ' "${DOC_MISS_ALL[@]}")"
}

doctor_json() {
  local t tier ver first=1 proj=null
  local -a miss=()
  if [[ -n $DOC_PROJECT ]]; then proj=$(jstr "$DOC_PROJECT"); fi
  printf '{"zide":%s,"distro":%s,"project":%s,"tools":[' "$(jstr "$ZIDE_VERSION")" "$(jstr "$(pkg_family)")" "$proj"
  for t in "${DOC_REQ[@]}" "${DOC_REC[@]}" "${DOC_OPT[@]}"; do
    tier=$(tool_tier "$t")
    if ((first)); then first=0; else printf ','; fi
    ver=$(tool_version "$t")
    case $ver in
      missing | broken*)
        printf '{"name":%s,"tier":%s,"present":false,"detail":%s}' "$(jstr "$t")" "$(jstr "$tier")" "$(jstr "$ver")"
        if [[ $tier == required ]]; then miss+=("$t"); fi
        ;;
      *)
        printf '{"name":%s,"tier":%s,"present":true,"version":%s}' "$(jstr "$t")" "$(jstr "$tier")" "$(jstr "$ver")"
        ;;
    esac
  done
  printf '],"missing_required":['
  first=1
  for t in "${miss[@]}"; do
    if ((first)); then first=0; else printf ','; fi
    printf '%s' "$(jstr "$t")"
  done
  if ((${#miss[@]})); then printf '],"ready":false}\n'; return 1; fi
  printf '],"ready":true}\n'
  return 0
}

cmd_doctor() {
  local t scope=""
  DOC_PROJECT=""
  if [[ -n ${POS_PATH:-} ]]; then
    POS_PATH=$(expand_tilde "$POS_PATH") || exit "$?"
    ROOT=$(safe_path "$POS_PATH") || exit "$?"
    [[ -d $ROOT ]] || die "$E_USAGE" "doctor: not a directory: $ROOT. Pass a project path, or run bare 'zide doctor' for the global toolchain report"
    scan_files
    detect_languages
    if ((!DETECT_C && !DETECT_CPP && !DETECT_RUST)); then
      die "$E_USAGE" "doctor: no C, C++ or Rust sources found under $ROOT. Pass a project path, or run bare 'zide doctor'"
    fi
    DOC_PROJECT=$ROOT
    scope=" for $ROOT"
  fi
  doctor_tiers
  if ((JSON_OUT)); then doctor_json; return $?; fi
  DOC_MISS_ALL=() DOC_MISS_REQ=() DOC_COLOR=0
  # Rows go to stdout: colorize only when stdout is a TTY too (keeps pipes clean).
  if [[ -n $C_RESET && -t 1 ]]; then DOC_COLOR=1; fi
  if ((DOC_COLOR)); then
    printf '%szide %s toolchain%s%s (distro: %s)\n' "$C_BOLD" "$ZIDE_VERSION" "$scope" "$C_RESET" "$(pkg_family)"
  else
    printf 'zide %s toolchain%s (distro: %s)\n' "$ZIDE_VERSION" "$scope" "$(pkg_family)"
  fi
  printf '\nrequired:\n'
  for t in "${DOC_REQ[@]}"; do doctor_row "$t" required; done
  printf '\nrecommended:\n'
  for t in "${DOC_REC[@]}"; do doctor_row "$t" recommended; done
  printf '\noptional:\n'
  for t in "${DOC_OPT[@]}"; do doctor_row "$t" optional; done
  printf '\n'
  doctor_summary
  if ((${#DOC_MISS_REQ[@]})); then return 1; fi
  return 0
}

# --------------------------------------------------------------------------
# Safe filesystem primitives
# --------------------------------------------------------------------------
ROOT=""
CREATED=() UPDATED=() UNCHANGED=() KEPT=() BACKUPS=()

rel() { printf '%s' "${1#"$ROOT"/}"; }

# Expand a leading ~ or ~/... using $HOME (~user forms stay literal); fail with E_USAGE when HOME is unset or empty.
expand_tilde() {
  local p=$1
  # Quoted "~" patterns match a literal tilde; the shell expands an unquoted ~ before we see it.
  # shellcheck disable=SC2088
  case $p in
    '~' | '~/'*)
      [[ -n ${HOME:-} ]] || die "$E_USAGE" "cannot expand '~' in path '$p': HOME is unset or empty (set HOME or use an absolute path)"
      printf '%s' "${p/#\~/$HOME}"
      ;;
    *)
      printf '%s' "$p"
      ;;
  esac
}

safe_path() {
  local p=$1 abs
  [[ -n $p ]] || die "$E_USAGE" "empty project path"
  abs=$(realpath -m -- "$p")
  case $abs in
    / | /bin | /bin/* | /boot | /boot/* | /dev | /dev/* | /etc | /etc/* | /home | /lib | /lib/* | /lib64 | /lib64/* | /opt | /opt/* | /proc | /proc/* | /root | /root/* | /run | /run/* | /sbin | /sbin/* | /srv | /srv/* | /sys | /sys/* | /usr | /usr/* | /var | /var/* | "${HOME:-/nonexistent}")
      die "$E_REFUSED" "refusing to operate on protected path '$abs': system locations are never touched (pick a directory under your home instead)"
      ;;
  esac
  printf '%s' "$abs"
}

mk_dir() {
  local d
  for d in "$@"; do
    if [[ -d $d ]]; then continue; fi
    if ((DRY_RUN)); then dry "mkdir -p $(rel "$d")"; else mkdir -p -- "$d"; fi
  done
}

backup_file() {
  local path=$1 stamp b n=0
  stamp=$(date -u '+%Y%m%dT%H%M%SZ')
  b="${path}.bak.${stamp}"
  while [[ -e $b || -L $b ]]; do
    n=$((n + 1))
    b="${path}.bak.${stamp}.${n}"
  done
  if ((DRY_RUN)); then
    dry "backup $(rel "$path") -> $(rel "$b")"
  else
    cp -a -- "$path" "$b"
    info "backup: $(rel "$path") -> $(rel "$b")"
    BACKUPS+=("$(rel "$b")")
  fi
}

# Dry-run previews (stderr, capped): what a create/patch would write.
dry_preview_new() { # <tmp>
  local n
  n=$(wc -l <"$1")
  head -n 12 "$1" | sed 's/^/    + /' >&2
  if ((n > 12)); then printf '    + ... (%d more lines)\n' "$((n - 12))" >&2; fi
}
dry_preview_diff() { # <old> <new> <rel>
  diff -u --label "a/$3" --label "b/$3" -- "$1" "$2" 2>/dev/null | head -n 24 | sed 's/^/    /' >&2 || true
}

# commit_file <src> <dest> <mode> <allow_modify:0|1>
commit_file() {  local src=$1 dest=$2 mode=$3 allow=${4:-0} r
  r=$(rel "$dest")
  if [[ -e $dest || -L $dest ]]; then
    if [[ -f $dest && ! -L $dest ]] && cmp -s -- "$src" "$dest"; then
      UNCHANGED+=("$r")
      dbg "unchanged: $r"
      if [[ $mode == 755 && ! -x $dest ]] && ((!DRY_RUN)); then chmod 755 -- "$dest"; fi
      return 0
    fi
    if ((!FORCE && !allow)); then
      KEPT+=("$r")
      info "kept your existing file (differs from template; --force replaces): $r"
      return 0
    fi
    backup_file "$dest"
    if ((DRY_RUN)); then dry "update $r"; dry_preview_diff "$dest" "$src" "$r"; else install -m "$mode" -- "$src" "$dest"; fi
    UPDATED+=("$r")
    return 0
  fi
  if ((DRY_RUN)); then
    dry "create $r"
    dry_preview_new "$src"
  else
    mkdir -p -- "$(dirname -- "$dest")"
    install -m "$mode" -- "$src" "$dest"
    dbg "created: $r"
  fi
  CREATED+=("$r")
}

validate_json() { # <file> <label>
  if ! have jq; then return 0; fi
  if ! jq -e . -- "$1" >/dev/null 2>&1; then
    err "generated JSON is invalid: $2"
    jq . -- "$1" 2>&1 | head -n 5 >&2 || true
    exit "$E_JSON"
  fi
}

# Merge helpers: <ours> <existing>; existing keys/entries always win.
merge_object() { jq --indent 2 -s '.[0] * .[1]' -- "$1" "$2"; }
merge_array() {
  jq --indent 2 -s '.[1] as $e | $e + (.[0] | map(select(.label as $l | ($e | map(.label) | index($l)) | not)))' -- "$1" "$2"
}

# put_file <dest> <kind: text|json|json-object|json-array> <mode>   (content in $TMP_LAST)
put_file() {
  local dest=$1 kind=${2:-text} mode=${3:-644} merged
  case $kind in json*) validate_json "$TMP_LAST" "$(rel "$dest")" ;; esac
  if [[ $kind == json-* && -f $dest && ! -L $dest ]] && ((!FORCE)) && have jq && ! cmp -s -- "$TMP_LAST" "$dest"; then
    if jq -e . -- "$dest" >/dev/null 2>&1; then
      mk_tmp
      merged=$TMP_LAST
      if [[ $kind == json-object ]]; then
        merge_object "$OURS" "$dest" >"$merged"
      else
        merge_array "$OURS" "$dest" >"$merged"
      fi
      if cmp -s <(jq -S . -- "$merged") <(jq -S . -- "$dest"); then
        UNCHANGED+=("$(rel "$dest") (already contains zide entries)")
        return 0
      fi
      commit_file "$merged" "$dest" "$mode" 1
      return 0
    fi
    KEPT+=("$(rel "$dest")")
    info "kept $(rel "$dest") (contains comments/invalid JSON, cannot merge safely; --force replaces)"
    return 0
  fi
  commit_file "$TMP_LAST" "$dest" "$mode" 0
}

OURS=""
# put_str <dest> <kind> <mode> <content>   (a trailing newline is appended)
put_str() {
  mk_tmp
  printf '%s\n' "$4" >"$TMP_LAST"
  OURS=$TMP_LAST
  put_file "$1" "$2" "$3"
}

declare -A TOK=()
# put_tpl <dest> <kind> <mode>   (template on stdin, @KEY@ tokens from TOK)
put_tpl() {
  local s k
  s=$(
    cat
    printf x
  )
  s=${s%x}
  for k in "${!TOK[@]}"; do s=${s//"@${k}@"/${TOK[$k]}}; done
  if [[ $s =~ @[A-Z][A-Z0-9_]*@ ]]; then
    die 1 "internal error: unresolved template token ${BASH_REMATCH[0]} for $(rel "$1")"
  fi
  mk_tmp
  printf '%s' "$s" >"$TMP_LAST"
  OURS=$TMP_LAST
  put_file "$1" "${2:-text}" "${3:-644}"
}

# Managed block in a text file (idempotent; preserves everything else).
BLOCK_BEGIN="# >>> zide >>>"
BLOCK_END="# <<< zide <<<"
put_block() { # <dest> <block-body>
  local dest=$1 body=$2 stripped="" new
  if [[ -f $dest ]]; then
    stripped=$(awk -v b="$BLOCK_BEGIN" -v e="$BLOCK_END" '$0==b{s=1;next} $0==e{s=0;next} !s{print}' "$dest")
  fi
  new="${stripped:+$stripped$'\n\n'}${BLOCK_BEGIN}"$'\n'"${body}"$'\n'"${BLOCK_END}"
  mk_tmp
  printf '%s\n' "$new" >"$TMP_LAST"
  if [[ -f $dest ]] && ! cmp -s -- "$TMP_LAST" "$dest"; then
    # Pure append / block refresh: the user's own lines are preserved verbatim.
    local r
    r=$(rel "$dest")
    backup_file "$dest"
    if ((DRY_RUN)); then dry "patch $r"; dry_preview_diff "$dest" "$TMP_LAST" "$r"; else install -m 644 -- "$TMP_LAST" "$dest"; fi
    UPDATED+=("$r (managed block)")
    return 0
  fi
  commit_file "$TMP_LAST" "$dest" 644 0
}

# Symlink ROOT/compile_commands.json -> relative target.
link_compdb() { # <relative-target>
  local target=$1 link=$ROOT/compile_commands.json cur
  if [[ -L $link ]]; then
    cur=$(readlink -- "$link")
    if [[ $cur == "$target" ]]; then
      UNCHANGED+=("compile_commands.json -> $target")
      return 0
    fi
    if [[ $cur == build/* || $cur == cmake-build-*/* ]] || ((FORCE)); then
      if ((DRY_RUN)); then dry "relink compile_commands.json -> $target"; else ln -sfn -- "$target" "$link"; fi
      UPDATED+=("compile_commands.json -> $target")
      return 0
    fi
  elif [[ -e $link ]] && ((!FORCE)); then
    KEPT+=("compile_commands.json")
    info "kept existing compile_commands.json (regular file)"
    return 0
  elif [[ -e $link ]]; then
    backup_file "$link"
  fi
  if [[ -L $link ]]; then
    KEPT+=("compile_commands.json (symlink -> $(readlink -- "$link"))")
    return 0
  fi
  if ((DRY_RUN)); then dry "symlink compile_commands.json -> $target"; else ln -sfn -- "$target" "$link"; fi
  CREATED+=("compile_commands.json -> $target")
}

# Run an external command; capture output and show the tail on failure.
# Never clobbers the caller's $TMP_LAST (templates may be mid-flight).
try_run() { # <description> <cmd...>
  local desc=$1 rc=0 prev_tmp=$TMP_LAST log
  shift
  if ((DRY_RUN)); then
    dry "$desc: $*"
    return 0
  fi
  mk_tmp
  log=$TMP_LAST
  TMP_LAST=$prev_tmp
  info "running: $desc"
  local start=$SECONDS took=0
  "$@" >"$log" 2>&1 || rc=$?
  took=$((SECONDS - start))
  if ((rc)); then
    warn "$desc failed after ${took}s (exit $rc); last output:"
    tail -n 8 "$log" | sed 's/^/        /' >&2
    return 1
  fi
  if ((VERBOSE)); then info "$desc finished in ${took}s"; fi
  return 0
}

# --------------------------------------------------------------------------
# Small JSON emitters (deterministic, no jq needed to generate)
# --------------------------------------------------------------------------
jstr() {
  local s=$1
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  s=${s//$'\n'/\\n}
  s=${s//$'\t'/\\t}
  printf '"%s"' "$s"
}
jarr() {
  local out="" a
  for a in "$@"; do out+="${out:+, }$(jstr "$a")"; done
  printf '[%s]' "$out"
}

TASKS=() DEBUGS=()
# add_task <label> <hide|""> <command> [args...]
add_task() {
  local label=$1 hide=$2 cmd=$3 o
  shift 3
  o=$(printf '  {\n    "label": %s,\n    "command": %s,\n    "args": %s,\n    "cwd": "$ZED_WORKTREE_ROOT"' \
    "$(jstr "$label")" "$(jstr "$cmd")" "$(jarr "$@")")
  if [[ -n $hide ]]; then o+=$(printf ',\n    "hide": %s' "$(jstr "$hide")"); fi
  TASKS+=("$o"$'\n  }')
}
# add_debug <label> <adapter> <program-relative-to-root> <build-task-label|"">
add_debug() {
  local o
  o=$(printf '  {\n    "label": %s,\n    "adapter": %s,\n    "request": "launch",\n    "program": %s,\n    "cwd": "$ZED_WORKTREE_ROOT"' \
    "$(jstr "$1")" "$(jstr "$2")" "$(jstr "\$ZED_WORKTREE_ROOT/$3")")
  if [[ -n $4 ]]; then o+=$(printf ',\n    "build": %s' "$(jstr "$4")"); fi
  DEBUGS+=("$o"$'\n  }')
}
emit_array() {
  local i n=$#
  printf '[\n'
  for ((i = 1; i <= n; i++)); do
    printf '%s' "${!i}"
    if ((i < n)); then printf ',\n'; else printf '\n'; fi
  done
  printf ']'
}
join_by() { # <sep> items...
  local sep=$1 out="" first=1 x
  shift
  for x in "$@"; do
    if ((first)); then out=$x first=0; else out+="$sep$x"; fi
  done
  printf '%s' "$out"
}

# --------------------------------------------------------------------------
# Shared Zed / clang config generators
# --------------------------------------------------------------------------
STYLE=llvm
zed_lang_block() { # <Zed language name> <formatter: language_server|default>
  if [[ $2 == language_server ]]; then
    printf '    %s: {\n      "tab_size": 4,\n      "format_on_save": "on",\n      "formatter": "language_server",\n      "inlay_hints": { "enabled": true }\n    }' "$(jstr "$1")"
  else
    printf '    %s: {\n      "tab_size": 4,\n      "format_on_save": "on",\n      "inlay_hints": { "enabled": true }\n    }' "$(jstr "$1")"
  fi
}

zed_settings() { # has_c has_cpp has_rust
  local -a langs=() lsp=()
  if (($1)); then langs+=("$(zed_lang_block C language_server)"); fi
  if (($2)); then langs+=("$(zed_lang_block 'C++' language_server)"); fi
  if (($3)); then langs+=("$(zed_lang_block Rust default)"); fi
  if (($1 || $2)); then
    lsp+=('    "clangd": {
      "binary": {
        "arguments": [
          "--background-index",
          "--clang-tidy",
          "--header-insertion=iwyu",
          "--completion-style=detailed"
        ]
      }
    }')
  fi
  if (($3)); then
    lsp+=('    "rust-analyzer": {
      "initialization_options": {
        "check": { "command": "clippy" },
        "cargo": { "allTargets": true }
      }
    }')
  fi
  printf '{\n  "languages": {\n%s\n  },\n  "lsp": {\n%s\n  }\n}' \
    "$(join_by $',\n' "${langs[@]}")" "$(join_by $',\n' "${lsp[@]}")"
}

# tasks_cmake <preset|""> <build-dir> <use_preset_for_build:0|1> targets...
tasks_cmake() {
  local preset=$1 dir=$2 usep=$3 t first=1
  shift 3
  local -a gen=()
  if have ninja; then gen=(-G Ninja); fi
  # Configure on first use so build/run/rebuild work on a fresh checkout; re-running over a cache keeps already-set variables.
  local cfg bld
  if [[ -n $preset ]]; then
    add_task "configure" "" cmake --preset "$preset"
  else
    add_task "configure" "" cmake -S . -B "$dir" -DCMAKE_EXPORT_COMPILE_COMMANDS=ON "${gen[@]}"
  fi
  if ((usep)); then
    cfg="[ -f $dir/CMakeCache.txt ] || cmake --preset $preset"
    bld="cmake --build --preset $preset"
    add_task "build" on_success cmake --build --preset "$preset"
    add_task "clean" "" cmake --build --preset "$preset" --target clean
    add_task "rebuild" on_success bash -c "$cfg && cmake --build --preset $preset --target clean && cmake --build --preset $preset"
    add_task "test" on_success ctest --preset "$preset"
  else
    cfg="[ -f $dir/CMakeCache.txt ] || cmake -S . -B $dir -DCMAKE_EXPORT_COMPILE_COMMANDS=ON${gen:+ ${gen[*]}}"
    bld="cmake --build $dir"
    add_task "build" on_success cmake --build "$dir"
    add_task "clean" "" cmake --build "$dir" --target clean
    add_task "rebuild" on_success bash -c "$cfg && cmake --build $dir --target clean && cmake --build $dir"
    add_task "test" on_success ctest --test-dir "$dir" --output-on-failure
  fi
  for t in "$@"; do
    if ((first)); then
      add_task "run" "" bash -c "$cfg && $bld && exec ./$dir/$t"
      first=0
    fi
    add_task "run: $t" "" bash -c "$cfg && $bld && exec ./$dir/$t"
  done
}

tasks_cargo() {
  add_task "build" on_success cargo build
  add_task "build: release" on_success cargo build --release
  add_task "check" on_success cargo check --all-targets
  add_task "clippy" on_success cargo clippy --all-targets -- -D warnings
  add_task "test" on_success cargo test
  add_task "run" "" cargo run
  add_task "clean" "" cargo clean
  add_task "fmt" on_success cargo fmt --all
}

clang_format_text() {
  local base
  case $STYLE in
    mozilla) base=Mozilla ;;
    google) base=Google ;;
    *) base=LLVM ;;
  esac
  printf 'BasedOnStyle: %s\nIndentWidth: 4\nColumnLimit: 100\nSortIncludes: CaseSensitive\nDerivePointerAlignment: false\nPointerAlignment: Left\n' "$base"
}

clangd_text() { # <compilation-db-dir or ".">
  printf '# Generated by zide. clangd reads this per-project configuration.\nCompileFlags:\n  CompilationDatabase: %s\n  Add: [-Wall, -Wextra]\nIndex:\n  Background: Build\nInlayHints:\n  Enabled: Yes\n  ParameterNames: Yes\n  DeducedTypes: Yes\n' "$1"
}

clang_tidy_text() {
  cat <<'EOF'
# Generated by zide.
Checks: 'bugprone-*,performance-*,portability-*,readability-*,modernize-use-nullptr,modernize-use-override,-readability-magic-numbers,-readability-identifier-length'
WarningsAsErrors: ''
HeaderFilterRegex: '.*/(include|src)/.*'
FormatStyle: file
EOF
}

gitignore_body() {
  cat <<'EOF'
/build/
/build-*/
/cmake-build-*/
/.cache/
/compile_commands.json
*.o
*.obj
*.a
*.so
*.dylib
*.gcda
*.gcno
*.profraw
*.bak.*
EOF
}

# --------------------------------------------------------------------------
# Detection
# --------------------------------------------------------------------------
FILES=()
DETECT_C=0 DETECT_CPP=0 DETECT_RUST=0 HAS_H=0
BUILDS=()
CC_BUILD=none

scan_files() {
  FILES=()
  local f
  while IFS= read -r -d '' f; do
    FILES+=("${f#"$ROOT"/}")
  done < <(find "$ROOT" -mindepth 1 -maxdepth 8 \
    \( -name .git -o -name build -o -name 'build-*' -o -name 'cmake-build-*' -o -name target \
    -o -name node_modules -o -name third_party -o -name vendor -o -name external \
    -o -name .cache -o -name .zed \) -prune -o -type f -print0 2>/dev/null | LC_ALL=C sort -z)
}

detect_languages() {
  local f
  DETECT_C=0 DETECT_CPP=0 DETECT_RUST=0 HAS_H=0
  for f in "${FILES[@]}"; do
    case $f in
      *.c) DETECT_C=1 ;;
      *.cc | *.cpp | *.cxx | *.hpp | *.hh | *.hxx | *.ipp | *.tcc) DETECT_CPP=1 ;;
      *.h) HAS_H=1 ;;
      *.rs) DETECT_RUST=1 ;;
    esac
  done
  if [[ -f $ROOT/Cargo.toml ]]; then DETECT_RUST=1; fi
  if ((HAS_H && !DETECT_C && !DETECT_CPP)); then DETECT_C=1; fi
}

detect_builds() {
  BUILDS=()
  if [[ -f $ROOT/CMakeLists.txt ]]; then BUILDS+=(cmake); fi
  if [[ -f $ROOT/meson.build ]]; then BUILDS+=(meson); fi
  if [[ -f $ROOT/Makefile || -f $ROOT/makefile || -f $ROOT/GNUmakefile ]]; then BUILDS+=(make); fi
  if [[ -f $ROOT/MODULE.bazel || -f $ROOT/WORKSPACE || -f $ROOT/WORKSPACE.bazel || -f $ROOT/BUILD.bazel ]]; then BUILDS+=(bazel); fi
  if [[ -f $ROOT/Cargo.toml ]]; then BUILDS+=(cargo); fi
  CC_BUILD=none
  local b
  for b in "${BUILDS[@]}"; do
    if [[ $b != cargo ]]; then CC_BUILD=$b; break; fi
  done
}

langs_label() {
  local -a x=()
  if ((DETECT_C)); then x+=(C); fi
  if ((DETECT_CPP)); then x+=("C++"); fi
  if ((DETECT_RUST)); then x+=(Rust); fi
  if ((${#x[@]})); then join_by ', ' "${x[@]}"; else printf 'none'; fi
}

make_ident() {
  local s
  s=$(printf '%s' "$1" | tr 'A-Z' 'a-z' | tr -c 'a-z0-9_' '_' | tr -s '_')
  s=${s#_}
  s=${s%_}
  if [[ -z $s ]]; then return 1; fi
  if [[ $s =~ ^[0-9] ]]; then s="p_$s"; fi
  printf '%s' "$s"
}

cmake_exe_targets() {
  local f
  for f in "${FILES[@]}"; do
    case $f in
      CMakeLists.txt | */CMakeLists.txt)
        { grep -ohE 'add_executable[[:space:]]*\([[:space:]]*[A-Za-z0-9_.+-]+' "$ROOT/$f" || true; } |
          sed -E 's/.*\([[:space:]]*//'
        ;;
    esac
  done | awk '!seen[$0]++'
}

cargo_pkg_name() {
  awk '/^\[package\]/{p=1;next} /^\[/{p=0} p && /^name[[:space:]]*=/{gsub(/^[^"]*"|".*$/,""); print; exit}' "$ROOT/Cargo.toml"
}

# has_main <relpath>: 0 when the file defines main() outside comments.
# Comment handling is a heuristic: // and /* */ are stripped, string and
# character literals are skipped, then main() must start a line.
has_main() {
  awk -v sq="'" '
    {
      line = $0
      out = ""
      q = ""
      i = 1
      n = length(line)
      while (i <= n) {
        c = substr(line, i, 1)
        two = substr(line, i, 2)
        if (inblock) {
          if (two == "*/") { inblock = 0; i += 2 } else { i++ }
        } else if (q != "") {
          out = out c
          if (c == "\\") { out = out substr(line, i + 1, 1); i += 2 }
          else { if (c == q) q = ""; i++ }
        } else if (two == "/*") { inblock = 1; i += 2 }
        else if (two == "//") { break }
        else {
          if (c == "\"" || c == sq) q = c
          out = out c
          i++
        }
      }
      if (out ~ /^[[:space:]]*(int|void)[[:space:]]+main[[:space:]]*\(/) found = 1
    }
    END { exit !found }
  ' "$ROOT/$1"
}

# entry_target <relpath> <ident> <used...>: unique target name on stdout.
# Derived from the relative path (/ - . become _), extension dropped.
entry_target() {
  local rel=$1 ident=$2 base t n=2 m taken
  shift 2
  base=${rel%.*}
  base=${base//\//_}
  base=${base//-/_}
  base=${base//./_}
  base=$(make_ident "$base") || base=target
  t=$base
  while :; do
    taken=0
    if [[ $t == "$ident" || $t == "${ident}_core" ]]; then taken=1; fi
    for m in "$@"; do
      if [[ $m == "$t" ]]; then taken=1; break; fi
    done
    ((taken)) || break
    t="${base}_${n}"
    n=$((n + 1))
  done
  if [[ $t != "$base" ]]; then info "target for $rel named $t (avoids a name collision)"; fi
  printf '%s' "$t"
}

# --------------------------------------------------------------------------
# Mode 1: adopt
# --------------------------------------------------------------------------
NO_CMAKE=0 NO_CONFIGURE=0 CONFIGURE=0 NO_CONFIGURE_FLAG=0 PLANNED_TARGETS=()
C_STD=17 CXX_STD=20
BUILD_DIR="" PRESET="" DB_DIR="."

adopt_generate_cmakelists() {
  local name ident langs f body="" tgt inc
  local -a libs=() mains=() incs=() std=() targets=()
  name=$(basename -- "$ROOT")
  ident=$(make_ident "$name") || ident=project
  for f in "${FILES[@]}"; do
    case $f in
      tests/* | test/* | */tests/* | */test/* | benchmarks/* | bench/* | */benchmarks/* | examples/* | */examples/* | docs/* | */docs/*) continue ;;
      *.c | *.cc | *.cpp | *.cxx)
        if has_main "$f"; then
          mains+=("$f")
        else
          libs+=("$f")
        fi
        ;;
    esac
  done
  if ((${#libs[@]} + ${#mains[@]} == 0)); then
    warn "no translation units found; not generating CMakeLists.txt"
    return 0
  fi
  if ((${#mains[@]})); then
    mapfile -t mains < <(printf '%s\n' "${mains[@]}" | LC_ALL=C sort -u)
  fi
  if ((DETECT_CPP)); then
    if ((DETECT_C)); then langs="C CXX"; else langs="CXX"; fi
  else
    langs="C"
  fi
  if ((DETECT_C)); then std+=("set(CMAKE_C_STANDARD $C_STD)" "set(CMAKE_C_STANDARD_REQUIRED ON)" "set(CMAKE_C_EXTENSIONS OFF)"); fi
  if ((DETECT_CPP)); then std+=("set(CMAKE_CXX_STANDARD $CXX_STD)" "set(CMAKE_CXX_STANDARD_REQUIRED ON)" "set(CMAKE_CXX_EXTENSIONS OFF)"); fi
  for inc in include src; do
    if [[ -d $ROOT/$inc ]]; then incs+=("\${CMAKE_CURRENT_SOURCE_DIR}/$inc"); fi
  done
  if ((${#incs[@]} == 0)); then incs+=("\${CMAKE_CURRENT_SOURCE_DIR}"); fi

  body="# Generated by zide from the sources found in this tree. Review before relying on it.
cmake_minimum_required(VERSION 3.16)
project(${ident} LANGUAGES ${langs})

set(CMAKE_EXPORT_COMPILE_COMMANDS ON)
$(printf '%s\n' "${std[@]}")
"
  if ((${#libs[@]})); then
    body+="
add_library(${ident}_core"$'\n'
    for f in "${libs[@]}"; do body+="  $f"$'\n'; done
    body+=")"$'\n'
    body+="target_include_directories(${ident}_core PUBLIC ${incs[*]})"$'\n'
  fi
  for f in "${mains[@]}"; do
    tgt=$(entry_target "$f" "$ident" "${targets[@]}")
    targets+=("$tgt")
    body+=$'\n'"add_executable(${tgt} $f)"$'\n'
    if ((${#libs[@]})); then
      body+="target_link_libraries(${tgt} PRIVATE ${ident}_core)"$'\n'
    else
      body+="target_include_directories(${tgt} PRIVATE ${incs[*]})"$'\n'
    fi
  done
  put_str "$ROOT/CMakeLists.txt" text 644 "$body"
  PLANNED_TARGETS=("${targets[@]}")
  info "CMake targets: ${#mains[@]} (one per file with main())"
}

# adopt_cmake_coverage: report entry points missing from a CMakeLists.txt
# zide did not generate. Matching file paths against the file text is a
# heuristic; the file itself is never modified. Read-only.
adopt_cmake_coverage() {
  local f total built=0 list shown=20
  local -a entries=() missing=()
  if grep -q "Generated by zide" "$ROOT/CMakeLists.txt"; then return 0; fi
  for f in "${FILES[@]}"; do
    case $f in
      tests/* | test/* | */tests/* | */test/* | benchmarks/* | bench/* | */benchmarks/* | examples/* | */examples/* | docs/* | */docs/*) continue ;;
      *.c | *.cc | *.cpp | *.cxx)
        if has_main "$f"; then entries+=("$f"); fi
        ;;
    esac
  done
  total=${#entries[@]}
  ((total)) || return 0
  for f in "${entries[@]}"; do
    if grep -qF "$f" "$ROOT/CMakeLists.txt"; then
      built=$((built + 1))
    else
      missing+=("$f")
    fi
  done
  if ((${#missing[@]} > shown)); then
    list="$(join_by ', ' "${missing[@]:0:shown}")"
    info "CMakeLists.txt was not generated by zide and was left unchanged. It builds $built of $total files with main(). Not included: $list, and $((${#missing[@]} - shown)) more (${#missing[@]} total)."
  elif ((${#missing[@]})); then
    list="$(join_by ', ' "${missing[@]}")"
    info "CMakeLists.txt was not generated by zide and was left unchanged. It builds $built of $total files with main(). Not included: $list (${#missing[@]} total)."
  else
    info "CMakeLists.txt was not generated by zide and was left unchanged. It builds $built of $total files with main()."
  fi
}

# announce_run <cmd...>: one-line pre-execution notice (stderr) naming the exact
# command and the directory it will run in. Always precedes execution.
announce_run() {
  local parts=() a
  for a in "$@"; do parts+=("$(printf '%q' "$a")"); done
  info "about to run (in $ROOT): ${parts[*]}"
}

# run_in_root <description> <cmd...>: announce, then run <cmd...> with cwd=$ROOT
# via try_run (captured output; nothing runs under --dry-run).
run_in_root() {
  local desc=$1
  shift
  announce_run "$@"
  try_run "$desc" bash -c 'cd -- "$1" && shift && "$@"' _ "$ROOT" "$@"
}

adopt_compdb() {
  local gen=() db
  if ((!DETECT_C && !DETECT_CPP)); then return 0; fi
  if ((!CONFIGURE)); then
    info "skipping configure (default; pass --configure to run the build system and export compile_commands.json)"
  else
    case $CC_BUILD in
      cmake | meson)
        info "generating compile_commands.json runs the project's '$CC_BUILD' configure step (project files execute)"
        ;;
    esac
  fi
  case $CC_BUILD in
    cmake)
      BUILD_DIR=build/zide PRESET=""
      if [[ -L $ROOT/compile_commands.json ]]; then
        db=$(readlink -- "$ROOT/compile_commands.json")
        # Reuse only a relative target; an absolute symlink points outside the tree.
        if [[ $db != /* && $db == */* ]]; then BUILD_DIR=$(dirname -- "$db"); fi
      elif [[ -f $ROOT/CMakePresets.json ]] && have jq &&
        jq -e '.configurePresets[]? | select(.name=="dev")' -- "$ROOT/CMakePresets.json" >/dev/null 2>&1; then
        PRESET=dev BUILD_DIR=build/dev
      fi
      DB_DIR=$BUILD_DIR
      if ((!CONFIGURE)); then
        : # skipped (see notice above); nothing here may execute project code
      elif [[ ! -f $ROOT/$BUILD_DIR/compile_commands.json ]]; then
        if ! have cmake; then
          warn "cmake not found; cannot export compile_commands.json -> $(install_hint cmake)"
        elif [[ -n $PRESET ]]; then
          run_in_root "cmake --preset dev (exporting compile commands)" \
            cmake --preset dev -DCMAKE_EXPORT_COMPILE_COMMANDS=ON || true
        else
          run_in_root "cmake configure -> $BUILD_DIR (exporting compile commands)" \
            cmake -S . -B "$BUILD_DIR" -DCMAKE_EXPORT_COMPILE_COMMANDS=ON "${gen[@]}" || true
        fi
      fi
      if [[ -f $ROOT/$BUILD_DIR/compile_commands.json ]] && [[ ! -e $ROOT/compile_commands.json || -L $ROOT/compile_commands.json ]]; then
        link_compdb "$BUILD_DIR/compile_commands.json"
      elif ((CONFIGURE)) && ((!DRY_RUN)) && [[ ! -e $ROOT/compile_commands.json ]]; then
        warn "compile_commands.json not produced although configure ran; check the output above, then re-run adopt"
      fi
      ;;
    meson)
      BUILD_DIR=build/zide DB_DIR=build/zide
      if ((!CONFIGURE)); then
        : # skipped (see notice above); nothing here may execute project code
      elif ! have meson; then
        warn "meson not found -> $(install_hint meson)"
      elif [[ ! -f $ROOT/$BUILD_DIR/build.ninja ]]; then
        run_in_root "meson setup $BUILD_DIR" meson setup "$BUILD_DIR" . || true
      fi
      if [[ -f $ROOT/$BUILD_DIR/compile_commands.json ]]; then link_compdb "$BUILD_DIR/compile_commands.json"; fi
      ;;
    make)
      DB_DIR="."
      if [[ -e $ROOT/compile_commands.json ]] || ((!CONFIGURE)); then
        : # skipped (see notice above); nothing here may execute project code
      elif have compiledb; then
        run_in_root "compiledb -n make (no build performed)" compiledb -n make || true
      elif have bear; then
        warn "bear must run a real build; forcing 'make -B' so every file is compiled"
        run_in_root "bear -- make -B" bear -- make -B "-j$(nproc)" || true
      else
        warn "no compile_commands generator for Make -> $(install_hint bear)  (or: $(install_hint compiledb))"
      fi
      ;;
    bazel)
      DB_DIR="."
      warn "Bazel: generate compile_commands.json with hedronvision/bazel-compile-commands-extractor (zide does not fetch it)"
      ;;
    *) DB_DIR="." ;;
  esac
}

adopt_zed() {
  local -a targets=()
  local name t
  name=$(basename -- "$ROOT")
  TASKS=() DEBUGS=()
  if ((DETECT_C || DETECT_CPP)); then
    # In a dry run the generated CMakeLists.txt exists only as a plan;
    # still plan its run/debug entries from the generated target list.
    if ((DRY_RUN)) && ((${#PLANNED_TARGETS[@]})); then CC_BUILD=cmake; fi
    case $CC_BUILD in
      cmake)
        mapfile -t targets < <(cmake_exe_targets)
        if ((DRY_RUN)) && ((${#PLANNED_TARGETS[@]})); then
          targets=("${PLANNED_TARGETS[@]}")
        fi
        if ((${#targets[@]} == 0)); then
          targets=("$(make_ident "$name" || echo app)")
          warn "no add_executable target detected; guessing binary name '${targets[0]}' (fix .zed/tasks.json if the binary is named differently)"
        else
          info "run/debug entries: ${#targets[@]} executable targets"
        fi
        if [[ -n $PRESET ]]; then
          tasks_cmake "$PRESET" "$BUILD_DIR" 1 "${targets[@]}"
        else
          tasks_cmake "" "$BUILD_DIR" 0 "${targets[@]}"
        fi
        for t in "${targets[@]}"; do
          add_debug "Debug $t (CodeLLDB)" CodeLLDB "$BUILD_DIR/$t" build
          add_debug "Debug $t (GDB)" GDB "$BUILD_DIR/$t" build
        done
        ;;
      meson)
        add_task "configure" "" bash -c "meson setup --reconfigure build/zide 2>/dev/null || meson setup build/zide"
        add_task "build" on_success meson compile -C build/zide
        add_task "clean" "" meson compile -C build/zide --clean
        add_task "test" on_success meson test -C build/zide --print-errorlogs
        add_debug "Debug $name (CodeLLDB)" CodeLLDB "build/zide/$name" build
        add_debug "Debug $name (GDB)" GDB "build/zide/$name" build
        ;;
      make)
        add_task "build" on_success bash -c 'make -j"$(nproc 2>/dev/null || echo 2)"'
        add_task "clean" "" make clean
        add_task "rebuild" on_success bash -c "make clean && make -j\$(nproc)"
        add_task "test" on_success make test
        add_debug "Debug $name (CodeLLDB)" CodeLLDB "$name" build
        add_debug "Debug $name (GDB)" GDB "$name" build
        ;;
      bazel)
        add_task "build" on_success bazel build //...
        add_task "test" on_success bazel test //...
        add_task "clean" "" bazel clean
        ;;
    esac
  fi
  if ((DETECT_RUST)) && [[ -f $ROOT/Cargo.toml ]]; then
    local pkg
    pkg=$(cargo_pkg_name)
    pkg=${pkg:-$name}
    if ((DETECT_C || DETECT_CPP)); then
      add_task "cargo build" on_success cargo build
      add_task "cargo test" on_success cargo test
      add_task "cargo run" "" cargo run
      add_task "cargo clippy" on_success cargo clippy --all-targets -- -D warnings
      add_debug "Debug $pkg (Rust, CodeLLDB)" CodeLLDB "target/debug/$pkg" "cargo build"
    else
      tasks_cargo
      add_debug "Debug $pkg (CodeLLDB)" CodeLLDB "target/debug/$pkg" build
      add_debug "Debug $pkg (GDB)" GDB "target/debug/$pkg" build
    fi
  fi
  if ((${#TASKS[@]} == 0)); then
    warn "no recognised build system; writing settings only (no tasks/debug profiles)"
  fi
  put_str "$ROOT/.zed/settings.json" json-object 644 "$(zed_settings "$DETECT_C" "$DETECT_CPP" "$DETECT_RUST")"
  if ((${#TASKS[@]})); then put_str "$ROOT/.zed/tasks.json" json-array 644 "$(emit_array "${TASKS[@]}")"; fi
  if ((${#DEBUGS[@]})); then put_str "$ROOT/.zed/debug.json" json-array 644 "$(emit_array "${DEBUGS[@]}")"; fi
}

adopt_clang() {
  if ((!DETECT_C && !DETECT_CPP)); then return 0; fi
  put_str "$ROOT/.clangd" text 644 "$(clangd_text "$DB_DIR")"
  put_str "$ROOT/.clang-format" text 644 "$(clang_format_text)"
  put_str "$ROOT/.clang-tidy" text 644 "$(clang_tidy_text)"
}

print_report() {
  local title=$1 x
  local dr=""
  if ((DRY_RUN)); then dr=" (dry run: nothing written)"; fi
  # Reports are human chatter: everything goes to stderr (stdout stays data-only).
  {
    printf '\n%s%s%s%s\n' "$C_BOLD" "$title" "$dr" "$C_RESET"
    printf '  project : %s\n' "$ROOT"
    if [[ $title == *adoption* ]]; then
      printf '  languages: %s\n  build   : %s (primary C/C++: %s)\n' "$(langs_label)" "${BUILDS[*]:-none}" "$CC_BUILD"
    fi
    printf '  created : %d\n' "${#CREATED[@]}"
    for x in "${CREATED[@]}"; do printf '      + %s\n' "$x"; done
    printf '  updated : %d\n' "${#UPDATED[@]}"
    for x in "${UPDATED[@]}"; do printf '      ~ %s\n' "$x"; done
    printf '  unchanged: %d   kept (yours): %d   backups: %d   warnings: %d\n' \
      "${#UNCHANGED[@]}" "${#KEPT[@]}" "${#BACKUPS[@]}" "${#WARNINGS[@]}"
    for x in "${KEPT[@]}"; do printf '      = %s\n' "$x"; done
    for x in "${BACKUPS[@]}"; do printf '      b %s\n' "$x"; done
    printf '  toolchain:\n'
    print_toolchain
  } >&2
}

cmd_adopt() {
  [[ -n ${POS_PATH:-} ]] || die "$E_USAGE" "adopt: missing <project-path>. Usage: zide adopt <project-path> [--dry-run]"
  POS_PATH=$(expand_tilde "$POS_PATH") || exit "$?"
  ROOT=$(safe_path "$POS_PATH") || exit "$?"
  [[ -d $ROOT ]] || die "$E_USAGE" "adopt: not a directory: $ROOT. Check the path, or scaffold a project with: zide init <path> --lang cpp -y"
  scan_files
  detect_languages
  detect_builds
  if ((NO_CONFIGURE_FLAG)); then
    warn "--no-configure is deprecated for adopt (not configuring is the default); the flag is accepted and changes nothing"
  fi
  if [[ -n $BUILD_SEL ]]; then
    case $BUILD_SEL in
      cmake)
        [[ -f $ROOT/CMakeLists.txt ]] || die "$E_USAGE" "adopt: --build cmake needs a CMakeLists.txt under $ROOT (detected: ${BUILDS[*]:-none}). Drop --build to let zide detect or generate one."
        BUILDS=(cmake)
        CC_BUILD=cmake
        ;;
      cargo)
        [[ -f $ROOT/Cargo.toml ]] || die "$E_USAGE" "adopt: --build cargo needs a Cargo.toml under $ROOT (detected: ${BUILDS[*]:-none}). Drop --build to let zide detect the build."
        BUILDS=(cargo)
        CC_BUILD=none
        ;;
    esac
  fi
  info "adopting $ROOT"
  info "languages: $(langs_label); build systems: ${BUILDS[*]:-none}"
  if ((DETECT_C || DETECT_CPP)); then
    need_tool clangd 1 "language server"
    need_tool cmake 0
    need_tool ninja 0
    need_tool jq 0 "JSON validation and safe merging"
    need_tool clang-format 0
  fi
  if ((DETECT_RUST)); then
    need_tool cargo 1
    need_tool rust-analyzer 1
  fi
  need_tool gdb 0 "debugger"
  need_tool lldb 0 "debugger (CodeLLDB is bundled with Zed)"
  if ((!DETECT_C && !DETECT_CPP && !DETECT_RUST)); then
    die "$E_USAGE" "no C, C++ or Rust sources found under $ROOT. To scaffold a new project instead: zide init <path> --lang <c | cpp | rust> -y"
  fi
  if (((DETECT_C || DETECT_CPP) && ${#BUILDS[@]} == 0 && !NO_CMAKE)); then
    info "no build system found; generating a CMakeLists.txt from the sources"
    adopt_generate_cmakelists
    # The file list predates the generated CMakeLists.txt, so rescan before target detection.
    scan_files
    detect_builds
  elif ((DETECT_C || DETECT_CPP)) && [[ $CC_BUILD == cmake ]]; then
    adopt_cmake_coverage
  fi
  adopt_compdb
  if ((DETECT_C || DETECT_CPP)) && [[ ! -e $ROOT/compile_commands.json ]] && ((!CONFIGURE)); then
    warn "no compile_commands.json (configure was not run): clangd in Zed will have degraded code intelligence (no accurate includes, defines, or jump-to-definition). Fix: zide adopt --configure $(printf '%q' "$ROOT"), or configure the build yourself and re-run adopt"
  fi
  adopt_zed
  adopt_clang
  put_block "$ROOT/.gitignore" "$(gitignore_body)"
  ok "adoption finished"
  print_report "Post-adoption report"
  printf '\nNext steps:\n  1. zed %q\n  2. Command palette -> "task: spawn" -> configure, build, test\n  3. If compile_commands.json is missing, run the "configure" task, then "editor: restart language server".\n' "$ROOT" >&2
}

