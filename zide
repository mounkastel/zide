init_resolve() {
  local ans="" pre=""
  ask LANG_SEL "Language (c | cpp | rust | c-cpp-mixed)" cpp
  pre=$LANG_SEL
  LANG_SEL=$(norm_lang "$pre") || die "$E_USAGE" "invalid --lang '$pre' (use c | cpp | rust | c-cpp-mixed)"
  if [[ $LANG_SEL == rust ]]; then
    TESTFW=cargo
  else
    if ((!STD_SET)) && [[ -t 0 && -t 2 ]] && ((!YES)); then
      case $LANG_SEL in c | mixed)
        while true; do
          read -r -p "C standard (11|17|23) [17]: " ans || ans=""
          C_STD=${ans:-17}
          if [[ $C_STD =~ ^(11|17|23)$ ]]; then break; fi
          err "unsupported C standard '$C_STD' (use 11, 17 or 23)"
        done
        ;;
      esac
      case $LANG_SEL in cpp | mixed)
        while true; do
          read -r -p "C++ standard (17|20|23) [20]: " ans || ans=""
          CXX_STD=${ans:-20}
          if [[ $CXX_STD =~ ^(17|20|23)$ ]]; then break; fi
          err "unsupported C++ standard '$CXX_STD' (use 17, 20 or 23)"
        done
        ;;
      esac
    fi
    ask TESTFW "Test framework (ctest | catch2 | doctest | gtest | none)" ctest
    pre=$TESTFW
    TESTFW=$(norm_test "$pre") || die "$E_USAGE" "invalid --test '$pre' (use ctest | catch2 | doctest | gtest | none)"
    if [[ $TESTFW == cargo ]]; then die "$E_USAGE" "--test cargo only applies to --lang rust (pick ctest | catch2 | doctest | gtest | none)"; fi
  fi
  ask LICENSE_SEL "License (mit | apache2 | bsd3 | gpl3 | none)" mit
  pre=$LICENSE_SEL
  LICENSE_SEL=$(norm_license "$pre") || die "$E_USAGE" "invalid --license '$pre' (use mit | apache2 | bsd3 | gpl3 | none)"
  if [[ -z $STRICT ]]; then
    local s=""
    ask s "Strict warnings -Wall -Wextra -Wpedantic -Werror? (y/n)" n
    case ${s,,} in y | yes) STRICT=1 ;; *) STRICT=0 ;; esac
  fi
  # A bare --std sets CXX_STD always and C_STD only when valid for C; validate only the languages used.
  case $LANG_SEL in
    c)
      if [[ -n $STD_BARE && ! $STD_BARE =~ ^(11|17|23)$ ]]; then
        die "$E_USAGE" "--std $STD_BARE does not apply to C (use 11, 17 or 23, e.g. --c-std 17)"
      fi
      [[ $C_STD =~ ^(11|17|23)$ ]] || die "$E_USAGE" "unsupported C standard: $C_STD (use 11, 17 or 23)"
      ;;
    cpp) [[ $CXX_STD =~ ^(17|20|23)$ ]] || die "$E_USAGE" "unsupported C++ standard: $CXX_STD (use 17, 20 or 23)" ;;
    mixed)
      [[ $C_STD =~ ^(11|17|23)$ ]] || die "$E_USAGE" "unsupported C standard: $C_STD (use 11, 17 or 23; e.g. --std 20 --c-std 17)"
      [[ $CXX_STD =~ ^(17|20|23)$ ]] || die "$E_USAGE" "unsupported C++ standard: $CXX_STD (use 17, 20 or 23)"
      ;;
  esac
  if [[ -z $INIT_NAME ]]; then INIT_NAME=$(basename -- "$ROOT"); fi
  if [[ $LANG_SEL == rust ]]; then
    CRATE=$(printf '%s' "$INIT_NAME" | tr 'A-Z' 'a-z' | tr -c 'a-z0-9_-' '-' | tr -s '-')
    CRATE=${CRATE#-}
    CRATE=${CRATE%-}
    [[ $CRATE =~ ^[a-z] ]] || die "$E_USAGE" "crate name must start with a letter: '$INIT_NAME' (override with --name NAME)"
    case $CRATE in
      as | break | const | continue | crate | else | enum | extern | false | fn | for | if | impl | in | let | loop | match | mod | move | mut | pub | ref | return | self | static | struct | super | trait | true | type | unsafe | use | where | while | async | await | dyn | try)
        die "$E_USAGE" "crate name '$CRATE' is a Rust keyword; choose another with --name NAME"
        ;;
    esac
    IDENT=${CRATE//-/_}
  else
    IDENT=$(make_ident "$INIT_NAME") || die "$E_USAGE" "cannot derive a valid identifier from '$INIT_NAME' (override with --name NAME)"
    if [[ $LANG_SEL != c ]]; then
      case $IDENT in
        alignas | alignof | asm | auto | bool | break | case | catch | char | char8_t | char16_t | char32_t | class | concept | const | consteval | constexpr | constinit | const_cast | continue | co_await | co_return | co_yield | decltype | default | delete | do | double | dynamic_cast | else | enum | explicit | export | extern | false | float | for | friend | goto | if | inline | int | long | mutable | namespace | new | noexcept | nullptr | operator | private | protected | public | register | reinterpret_cast | requires | return | short | signed | sizeof | static | static_assert | static_cast | struct | switch | template | this | thread_local | throw | true | try | typedef | typeid | typename | union | unsigned | using | virtual | void | volatile | wchar_t | while)
          die "$E_USAGE" "derived identifier '$IDENT' is a C++ keyword and would not compile; choose another with --name NAME"
          ;;
      esac
    fi
  fi
  AUTHOR=${AUTHOR:-$(git config --get user.name 2>/dev/null || true)}
  AUTHOR=${AUTHOR:-${USER:-author}}
  YEAR=${YEAR:-$(date +%Y)}
  [[ $YEAR =~ ^[0-9]{4}(-[0-9]{4})?$ ]] || die "$E_USAGE" "invalid --year '$YEAR' (use YYYY, e.g. 2024)"
}

init_tokens() {
  local langs std ext hdr add
  case $LANG_SEL in
    c)
      langs=C ext=c hdr="$IDENT/$IDENT.h" add="${IDENT}_add"
      std="set(CMAKE_C_STANDARD $C_STD)
set(CMAKE_C_STANDARD_REQUIRED ON)
set(CMAKE_C_EXTENSIONS OFF)"
      ;;
    cpp)
      langs=CXX ext=cpp hdr="$IDENT/$IDENT.hpp" add="${IDENT}::add"
      std="set(CMAKE_CXX_STANDARD $CXX_STD)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)"
      ;;
    mixed)
      langs="C CXX" ext=cpp hdr="$IDENT/$IDENT.hpp" add="${IDENT}::add"
      std="set(CMAKE_C_STANDARD $C_STD)
set(CMAKE_C_STANDARD_REQUIRED ON)
set(CMAKE_C_EXTENSIONS OFF)
set(CMAKE_CXX_STANDARD $CXX_STD)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)"
      ;;
    *) langs="" ext="" hdr="" add="" std="" ;;
  esac
  local gen
  gen=$GENERATOR
  if [[ $gen == auto ]]; then
    if have ninja; then gen=ninja; else gen="make"; fi
  fi
  if [[ $gen == ninja ]]; then
    TOK[GENERATOR_LINE]='"generator": "Ninja",'
  else
    TOK[GENERATOR_LINE]='"generator": "Unix Makefiles",'
  fi
  TOK[NAME]=$INIT_NAME TOK[IDENT]=$IDENT TOK[UPPER]=${IDENT^^} TOK[LANGS]=$langs
  TOK[EXT]=$ext TOK[HDR]=$hdr TOK[ADD]=$add TOK[STD_BLOCK]=$std
  TOK[STRICT_ONOFF]=$([[ $STRICT == 1 ]] && echo ON || echo OFF)
  TOK[STRICT_JSON]=$([[ $STRICT == 1 ]] && echo ON || echo OFF)
  TOK[BENCH_ONOFF]=$([[ $BENCH == 1 ]] && echo ON || echo OFF)
  TOK[TESTFW]=$TESTFW TOK[CRATE]=$CRATE TOK[LICENSE]=$LICENSE_SEL
  TOK[STYLE]=$STYLE TOK[LANG]=$LANG_SEL
}

