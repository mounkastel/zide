usage() {
  cat <<EOF
$PROG $ZIDE_VERSION - Zed IDE setup for C, C++ and Rust projects

Usage:
  $PROG [options] adopt <path>   retrofit a project (never breaks your build)
  $PROG [options] init <path>    scaffold a project that builds and tests
  $PROG doctor [--json] [path]   toolchain report, scoped to the project if given
  $PROG -i [adopt|init] [path]   guided wizard (default when run in a terminal)

Run control:
  -n, --dry-run    plan only: list actions and show diffs, change nothing
  -f, --force      replace differing files (originals kept as *.bak.<UTC>)
  -y, --yes        never prompt; take defaults for anything not passed
  -v, --verbose    extra detail (and internal locations on failure)
  --no-color       plain output (NO_COLOR is honoured too)

adopt:
  --build B        drive only this build system: cmake | cargo
  --configure      run the build system to export compile_commands.json
                   (project code executes; the default is to run nothing)
  --no-configure   accepted for compatibility with scripts written against preview builds; equivalent to the default
  --no-cmake       never generate a CMakeLists.txt
  --std N          standard for a generated CMakeLists (C++ 17|20|23, C 11|17|23)
  --style S        clang-format base: llvm | mozilla | google

init:
  --lang L         c | cpp | rust | c-cpp-mixed              (default: cpp)
  --build B        must agree with --lang: cmake | cargo
  --std N          C++ standard 17|20|23 (also used for C if 11|17|23)
  --c-std N        C standard 11|17|23                      (default: 17)
  --test T         ctest | catch2 | doctest | gtest | none   (default: ctest)
  --license L      mit | apache2 | bsd3 | gpl3 | none        (default: mit)
  --name N         project name          (default: directory name)
  --author N       license holder        (default: git user.name)
  --year YYYY      license year          (default: current year)
  --strict         -Wall -Wextra -Wpedantic -Werror (deny warnings for Rust)
  --benchmarks     add a benchmarks/ target (opt-in)
  --generator G    CMake generator: auto | ninja | make    (default: auto)
  --style S        clang-format base: llvm | mozilla | google
  --no-git         skip git init and the initial commit
  --bare-remote D  bare repo at D with a post-receive stub, added as 'origin'
  --no-configure   skip the initial 'cmake --preset dev'
  (aliases: --language, --test-framework; --git / --no-bench negate --no-git / --benchmarks)

Examples:
  $PROG adopt ~/src/legacy --dry-run
  $PROG init ~/src/fastcalc --lang cpp --std 20 --strict --test doctest -y
  $PROG init ./bridge --lang c-cpp-mixed --benchmarks -y

Exit codes: 0 ok, 1 failure, 2 usage, 3 bad generated JSON, 4 refused, 130 interrupted.
Safety: differing files are kept unless --force (then backed up); .zed/*.json are
merged (your keys win); --dry-run writes nothing; system paths are refused.
EOF
}

# --------------------------------------------------------------------------
# Interactive wizard (zide -i, or just `zide` in a terminal)
# --------------------------------------------------------------------------
INTERACTIVE=0
RUN_RC=0
WIZ_VARS=(LANG_SEL INIT_NAME TESTFW LICENSE_SEL AUTHOR YEAR STRICT BENCH GIT STYLE C_STD CXX_STD STD_SET NO_CMAKE NO_CONFIGURE CONFIGURE POS_PATH BARE_REMOTE FORCE)
declare -A WIZ_SNAP=()

wiz_snapshot() {
  local v
  for v in "${WIZ_VARS[@]}"; do WIZ_SNAP[$v]=${!v}; done
}
wiz_restore() {
  local v
  for v in "${WIZ_VARS[@]}"; do printf -v "$v" '%s' "${WIZ_SNAP[$v]}"; done
}

ui_banner() {
  printf '\n%s%szide %s%s  %sZed IDE setup wizard%s\n' "$C_BOLD" "$C_CYAN" "$ZIDE_VERSION" "$C_RESET" "$C_DIM" "$C_RESET" >&2
  printf '%s  Up/Down or j/k move, Enter selects, 1-9 jump to an item, Ctrl-C quits.%s\n' "$C_DIM" "$C_RESET" >&2
}
ui_section() { printf '\n%s== %s ==%s\n' "$C_BOLD" "$1" "$C_RESET" >&2; }

# ui_input <var> <question> <default>   (readline editing, Tab completes paths)
# The default shows as a hint and the buffer starts empty; Enter accepts the default and typed text replaces it.
ui_input() {
  local -n _ui_ref=$1
  local ans=""
  printf '%s?%s %s [%s]:\n' "$C_CYAN" "$C_RESET" "$2" "$3" >&2
  read -r -e -p "  > " ans || die 130 "input closed; wizard cancelled"
  _ui_ref=${ans:-$3}
}

# ui_confirm <question> <default y|n>   returns 0 for yes
ui_confirm() {
  local q=$1 def=${2:-y} hint ans
  if [[ $def == y ]]; then hint="Y/n"; else hint="y/N"; fi
  while true; do
    printf '%s?%s %s [%s] ' "$C_CYAN" "$C_RESET" "$q" "$hint" >&2
    IFS= read -rsn1 ans || die 130 "input closed; wizard cancelled"
    case ${ans,,} in
      y) printf 'yes\n' >&2; return 0 ;;
      n) printf 'no\n' >&2; return 1 ;;
      '')
        if [[ $def == y ]]; then printf 'yes\n' >&2; return 0; fi
        printf 'no\n' >&2
        return 1
        ;;
    esac
    printf '\r\033[K' >&2
  done
}

# ui_choose <var> <title> <default-value> "value|label" ...
ui_choose() {
  local -n _ui_ref=$1
  local title=$2 def=$3 o i sel=0 n key rest=""
  local -a vals=() labels=()
  shift 3
  for o in "$@"; do
    vals+=("${o%%|*}")
    labels+=("${o#*|}")
  done
  n=${#vals[@]}
  for ((i = 0; i < n; i++)); do
    if [[ ${vals[i]} == "$def" ]]; then sel=$i; fi
  done
  printf '%s?%s %s%s%s\n' "$C_CYAN" "$C_RESET" "$C_BOLD" "$title" "$C_RESET" >&2
  printf '\033[?25l' >&2
  while true; do
    for ((i = 0; i < n; i++)); do
      if ((i == sel)); then
        printf '  %s> %s%s\033[K\n' "$C_CYAN" "${labels[i]}" "$C_RESET" >&2
      else
        printf '    %s\033[K\n' "${labels[i]}" >&2
      fi
    done
    IFS= read -rsn1 key || { printf '\033[?25h' >&2; die 130 "input closed; wizard cancelled"; }
    if [[ $key == $'\033' ]]; then
      rest=""
      read -rsn2 -t 0.05 rest || true
      key=$rest
    fi
    case $key in
      '[A' | k) sel=$(((sel - 1 + n) % n)) ;;
      '[B' | j) sel=$(((sel + 1) % n)) ;;
      '') break ;;
      [1-9]) if ((key <= n)); then sel=$((key - 1)); fi ;;
    esac
    printf '\033[%dA' "$n" >&2
  done
  printf '\033[?25h\033[%dA\033[J' "$((n + 1))" >&2
  printf '%s?%s %s %s-> %s%s\n' "$C_CYAN" "$C_RESET" "$title" "$C_GREEN" "${labels[sel]%%  (*}" "$C_RESET" >&2
  _ui_ref=${vals[sel]}
}

# Run a command in a subshell so that die()/exit does not end the wizard.
run_isolated() {
  set +e
  (
    set -e
    trap cleanup EXIT
    "$@"
  )
  RUN_RC=$?
  set -e
  return 0
}

yesno() { if (($1)); then printf 'yes'; else printf 'no'; fi; }

wiz_apply() { # <command-function> <project-root>
  local choice
  while true; do
    ui_choose choice "Ready?" apply \
      "apply|Apply now" \
      "preview|Preview first (dry-run: nothing is written or executed)" \
      "cancel|Cancel"
    case $choice in
      preview)
        DRY_RUN=1
        run_isolated "$1"
        DRY_RUN=0
        ;;
      apply)
        run_isolated "$1"
        if ((RUN_RC)); then
          err "finished with errors (exit $RUN_RC)"
        elif have zed && ui_confirm "Open the project in Zed now?" y; then
          (zed "$2" >/dev/null 2>&1 &)
        fi
        return 0
        ;;
      cancel)
        info "cancelled; nothing was changed"
        return 0
        ;;
    esac
  done
}

wizard_init() {
  local default_author pre=""
  wiz_restore
  ui_section "New project"
  while true; do
    if [[ -z $POS_PATH ]]; then ui_input POS_PATH "Project directory (created if missing)" "./my-project"; fi
    POS_PATH=$(expand_tilde "$POS_PATH") || exit "$?"
    if ROOT=$(safe_path "$POS_PATH"); then break; fi
    POS_PATH=""
  done
  if [[ -d $ROOT && -n $(find "$ROOT" -mindepth 1 -maxdepth 1 -print -quit) ]]; then
    info "directory is not empty: existing files are preserved unless you allow replacing them"
  fi
  while [[ -z $INIT_NAME ]]; do ui_input INIT_NAME "Project name" "$(basename -- "$ROOT")"; done
  if [[ -n $LANG_SEL ]]; then
    pre=$LANG_SEL
    if ! LANG_SEL=$(norm_lang "$pre"); then
      warn "ignoring invalid pre-filled language '$pre' (use c | cpp | mixed | rust); please choose"
      LANG_SEL=""
    fi
  fi
  if [[ -z $LANG_SEL ]]; then
    ui_choose LANG_SEL "Language" cpp \
      "cpp|C++" "c|C" "mixed|C and C++ in one project" "rust|Rust (cargo)"
    LANG_SEL=$(norm_lang "$LANG_SEL") # menu values are always valid
  fi
  if ((!STD_SET)); then
    case $LANG_SEL in c | mixed)
      ui_choose C_STD "C standard" "$C_STD" "17|C17" "11|C11" "23|C23"
      ;;
    esac
    case $LANG_SEL in cpp | mixed)
      ui_choose CXX_STD "C++ standard" "$CXX_STD" "20|C++20" "17|C++17" "23|C++23"
      ;;
    esac
    STD_SET=1
  fi
  if [[ $LANG_SEL == rust ]]; then
    TESTFW=cargo
  elif [[ $LANG_SEL == c ]]; then
    TESTFW=ctest
  else
    if [[ -n $TESTFW ]]; then
      pre=$TESTFW
      if ! TESTFW=$(norm_test "$pre"); then
        warn "ignoring invalid pre-filled test framework '$pre'; please choose"
        TESTFW=""
      fi
    fi
    if [[ -z $TESTFW ]]; then
      ui_choose TESTFW "Test framework" ctest \
        "ctest|CTest smoke test (no dependencies)" \
        "catch2|Catch2  (used only if installed system-wide)" \
        "doctest|doctest  (used only if installed system-wide)" \
        "gtest|GoogleTest  (used only if installed system-wide)" \
        "none|No tests"
    fi
  fi
  if [[ -n $LICENSE_SEL ]]; then
    pre=$LICENSE_SEL
    if ! LICENSE_SEL=$(norm_license "$pre"); then
      warn "ignoring invalid pre-filled license '$pre'; please choose"
      LICENSE_SEL=""
    fi
  fi
  if [[ -z $LICENSE_SEL ]]; then
    ui_choose LICENSE_SEL "License" mit \
      "mit|MIT" "apache2|Apache-2.0" "bsd3|BSD-3-Clause" "gpl3|GPL-3.0-or-later" "none|No license file"
  fi
  if [[ -z $AUTHOR ]]; then
    default_author=$(git config --get user.name 2>/dev/null || true)
    ui_input AUTHOR "License holder" "${default_author:-${USER:-author}}"
  fi
  if [[ -z $STRICT ]]; then
    if ui_confirm "Strict warnings (-Wall -Wextra -Wpedantic -Werror / deny warnings)?" n; then STRICT=1; else STRICT=0; fi
  fi
  if [[ $LANG_SEL != rust ]]; then
    if ui_confirm "Add a benchmarks/ target?" "$([[ $BENCH == 1 ]] && echo y || echo n)"; then BENCH=1; else BENCH=0; fi
    ui_choose STYLE "clang-format style" "$STYLE" "llvm|LLVM" "google|Google" "mozilla|Mozilla"
    if ui_confirm "Run 'cmake --preset dev' now so clangd works immediately?" "$([[ $NO_CONFIGURE == 1 ]] && echo n || echo y)"; then NO_CONFIGURE=0; else NO_CONFIGURE=1; fi
  fi
  if ui_confirm "Initialise a git repository with a first commit?" "$([[ $GIT == 1 ]] && echo y || echo n)"; then GIT=1; else GIT=0; fi
  if [[ -d $ROOT ]] && ui_confirm "Replace existing files that differ from the templates? (backups are made)" "$([[ $FORCE == 1 ]] && echo y || echo n)"; then FORCE=1; else FORCE=0; fi

  ui_section "Summary"
  {
    printf '  %-12s %s\n' "directory" "$ROOT" "name" "$INIT_NAME" "language" "$LANG_SEL"
    if [[ $LANG_SEL != rust ]]; then
      printf '  %-12s C++%s / C%s\n' "standard" "$CXX_STD" "$C_STD"
      printf '  %-12s %s\n' "tests" "$TESTFW" "format" "$STYLE"
    fi
    printf '  %-12s %s\n' "license" "$LICENSE_SEL" "strict" "$(yesno "$STRICT")" "git" "$(yesno "$GIT")"
  } >&2
  wiz_apply cmd_init "$ROOT"
}

wizard_adopt() {
  wiz_restore
  ui_section "Adopt an existing project"
  while true; do
    if [[ -z $POS_PATH ]]; then ui_input POS_PATH "Path to the project" "."; fi
    POS_PATH=$(expand_tilde "$POS_PATH") || exit "$?"
    if ROOT=$(safe_path "$POS_PATH") && [[ -d $ROOT ]]; then break; fi
    err "not a directory: $POS_PATH"
    POS_PATH=""
  done
  scan_files
  detect_languages
  detect_builds
  info "found: languages = $(langs_label); build systems = ${BUILDS[*]:-none}"
  if ((!DETECT_C && !DETECT_CPP && !DETECT_RUST)); then
    err "no C, C++ or Rust sources here; nothing to adopt"
    return 0
  fi
  if ((DETECT_C || DETECT_CPP)); then
    if ((${#BUILDS[@]} == 0)); then
      if ui_confirm "No build system found. Generate a CMakeLists.txt from the sources?" y; then NO_CMAKE=0; else NO_CMAKE=1; fi
      if ((!NO_CMAKE && !STD_SET)); then
        if ((DETECT_CPP)); then ui_choose CXX_STD "C++ standard for the generated CMakeLists.txt" "$CXX_STD" "20|C++20" "17|C++17" "23|C++23"; fi
        if ((DETECT_C)); then ui_choose C_STD "C standard for the generated CMakeLists.txt" "$C_STD" "17|C17" "11|C11" "23|C23"; fi
      fi
    fi
    ui_choose STYLE "clang-format style (an existing .clang-format is never touched)" "$STYLE" \
      "llvm|LLVM" "google|Google" "mozilla|Mozilla"
    if ui_confirm "Run the build system to generate compile_commands.json now? (project code will execute)" "$([[ $CONFIGURE == 1 ]] && echo y || echo n)"; then CONFIGURE=1; NO_CONFIGURE=0; else CONFIGURE=0; NO_CONFIGURE=1; fi
  fi
  if ui_confirm "Replace files that differ from the templates? (No = keep yours and merge .zed/*.json)" "$([[ $FORCE == 1 ]] && echo y || echo n)"; then FORCE=1; else FORCE=0; fi
  ui_section "Summary"
  printf '  %-12s %s\n  %-12s %s\n  %-12s %s\n  %-12s %s\n' \
    "project" "$ROOT" "languages" "$(langs_label)" "build" "${BUILDS[*]:-none}" "overwrite" "$(yesno "$FORCE")" >&2
  wiz_apply cmd_adopt "$ROOT"
}

cmd_wizard() {
  local action=$POS_CMD
  [[ -t 0 && -t 2 ]] || die "$E_USAGE" "interactive mode needs a terminal (run non-interactively instead, e.g. zide init ./my-project --lang cpp -y)"
  YES=1
  wiz_snapshot
  ui_banner
  while true; do
    if [[ -z $action ]]; then
      printf '\n' >&2
      ui_choose action "What would you like to do?" init \
        "init|Create a new project  (builds and tests out of the box)" \
        "adopt|Adopt an existing project  (Zed + clangd + tasks + debug)" \
        "doctor|Check my toolchain" \
        "quit|Quit"
    fi
    case $action in
      init) wizard_init ;;
      adopt) wizard_adopt ;;
      doctor) cmd_doctor ;;
      quit) return 0 ;;
      *) die "$E_USAGE" "unknown wizard command '$action' (choose init | adopt | doctor)" ;;
    esac
    action=""
    printf '\n' >&2
    if ! ui_confirm "Do something else?" n; then return 0; fi
  done
}

POS_CMD="" POS_PATH=""
parse_args() {
  local -a args=("$@")
  local i=0 a v eq pos=0 rest=0
  while ((i < ${#args[@]})); do
    a=${args[i]}
    i=$((i + 1))
    if ((rest)) || [[ $a != -* ]]; then
      pos=$((pos + 1))
      case $pos in
        1) POS_CMD=$a ;;
        2) POS_PATH=$a ;;
        *) die "$E_USAGE" "unexpected argument '$a' (usage: zide [options] <adopt|init|doctor> <path>; see zide --help)" ;;
      esac
      continue
    fi
    eq=0 v=""
    if [[ $a == --*=* ]]; then
      v=${a#*=} a=${a%%=*} eq=1
    fi
    case $a in
      --) rest=1 ;;
      -h | --help) usage; exit 0 ;;
      --version) printf '%s %s\n' "$PROG" "$ZIDE_VERSION"; exit 0 ;;
      -v | --verbose) VERBOSE=1 ;;
      -n | --dry-run) DRY_RUN=1 ;;
      -f | --force) FORCE=1 ;;
      -y | --yes) YES=1 ;;
      -i | --interactive) INTERACTIVE=1 ;;
      --no-color) COLOR=never ;;
      --json) JSON_OUT=1 ;; # machine-readable output (currently: doctor only)
      --no-cmake) NO_CMAKE=1 ;;
      --configure) CONFIGURE=1; NO_CONFIGURE=0 ;;
      --no-configure) NO_CONFIGURE=1; CONFIGURE=0; NO_CONFIGURE_FLAG=1 ;;
      --strict) STRICT=1 ;;
      --benchmarks) BENCH=1 ;;
      --no-bench) BENCH=0 ;;
      --git) GIT=1 ;;
      --no-git) GIT=0 ;;
      --name | --lang | --language | --std | --c-std | --test | --test-framework | --license | --author | --year | --style | --generator | --bare-remote | --build | --build-system)
        if ((!eq)); then
          ((i < ${#args[@]})) || die "$E_USAGE" "missing value for $a (usage: $a VALUE; see zide --help)"
          v=${args[i]}
          i=$((i + 1))
        fi
        case $a in
          --name) INIT_NAME=$v ;;
          --lang | --language) LANG_SEL=$v ;;
          --test | --test-framework) TESTFW=$v ;;
          --license) LICENSE_SEL=$v ;;
          --author) AUTHOR=$v ;;
          --year) YEAR=$v ;;
          --bare-remote) BARE_REMOTE=$v ;;
          --build | --build-system)
            BUILD_SEL=${v,,}
            case $BUILD_SEL in cmake | cargo) ;; *) die "$E_USAGE" "unsupported build system: $v (use cmake | cargo)" ;; esac
            ;;
          --style)
            STYLE=${v,,}
            case $STYLE in llvm | mozilla | google) ;; *) die "$E_USAGE" "unknown --style '$v' (use llvm | mozilla | google)" ;; esac
            ;;
          --generator)
            GENERATOR=${v,,}
            case $GENERATOR in auto | ninja | make) ;; *) die "$E_USAGE" "unknown --generator '$v' (use auto | ninja | make)" ;; esac
            ;;
          --std)
            STD_SET=1
            case ${v,,} in
              c++*) CXX_STD=${v#*++} ;;
              c[0-9]*) C_STD=${v#[cC]} ;;
              *)
                # A bare N is the C++ standard; use it for C only when valid for C.
                STD_BARE=$v
                CXX_STD=$v
                case $v in 11 | 17 | 23) C_STD=$v ;; esac
                ;;
            esac
            ;;
          --c-std)
            STD_SET=1
            C_STD=${v#[cC]}
            ;;
        esac
        ;;
      *) die "$E_USAGE" "unknown option '$a' (see: zide --help)" ;;
    esac
  done
}

main() {
  setup_colors
  parse_args "$@"
  setup_colors
  if ((INTERACTIVE)) || { [[ -z $POS_CMD ]] && [[ -t 0 && -t 2 ]]; }; then
    INTERACTIVE=1
    cmd_wizard
    return 0
  fi
  case $POS_CMD in
    adopt) cmd_adopt ;;
    init) cmd_init ;;
    doctor) cmd_doctor ;;
    help) usage ;;
    "") usage >&2; exit "$E_USAGE" ;;
    *) die "$E_USAGE" "unknown command '$POS_CMD'. Run one of: zide adopt <path> | zide init <path> | zide doctor (see zide --help)" ;;
  esac
}

main "$@"
